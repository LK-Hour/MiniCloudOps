// Grafana Alloy: collect Docker container logs and ship them to Loki.

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s" // pick up containers started after Alloy (default is 60 s)
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
  targets       = discovery.relabel.containers.output
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.json_logs.receiver]
}

// MiniOps services log JSON. Promote `level` to a label (low cardinality).
// correlation_id stays in the log line: query it with  {service="..."} | json | correlation_id="req-..."
loki.process "json_logs" {
  stage.json {
    expressions = { level = "level" }
  }

  stage.labels {
    values = { level = "" }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
