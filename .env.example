# Copy to .env and change every password:  cp .env.example .env
# Never commit .env.

# --- Images (GHCR) ---
GHCR_OWNER=your-github-username-or-org
IMAGE_TAG=latest

# --- Ports published on localhost ---
GATEWAY_PORT=8080
FRONTEND_PORT=3000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# --- PostgreSQL superuser (used only by the init script) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# --- One user per service database ---
TARGET_DB_USER=target_svc
TARGET_DB_PASSWORD=change-me-target
MONITORING_DB_USER=monitoring_svc
MONITORING_DB_PASSWORD=change-me-monitoring
INCIDENT_DB_USER=incident_svc
INCIDENT_DB_PASSWORD=change-me-incident
NOTIFICATION_DB_USER=notification_svc
NOTIFICATION_DB_PASSWORD=change-me-notification

# --- Monitoring thresholds (demo values) ---
DEFAULT_CHECK_INTERVAL_SECONDS=30
FAILURE_THRESHOLD=3
RESPONSE_TIME_THRESHOLD_MS=2000

# --- Target URL safety (SSRF) ---
# true: targets may use private addresses (needed for apps running in Docker Compose).
# false: only public addresses. Loopback, link-local and cloud metadata are always blocked.
SSRF_ALLOW_PRIVATE_NETWORKS=true

# --- Logging ---
LOG_LEVEL=INFO

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Telegram alerts (optional; leave empty for dashboard-only notifications) ---
# 1. Create a bot with @BotFather and paste its token below.
# 2. Send the bot any message (or add it to a group), then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Time zone for times in alerts (IANA name), e.g. Asia/Phnom_Penh
ALERT_TIMEZONE=UTC
# Bot commands in the chat (/status, /menu, /targets, /incidents, /check, /quiet).
# Only TELEGRAM_CHAT_ID is answered. false: alerts only.
TELEGRAM_COMMANDS_ENABLED=true
